rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() >= 1 && val.size() <= maxLen;
    }

    function isOptionalString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isReasonablePayload() {
      return request.resource == null || request.resource.data.keys().size() <= 120;
    }

    function isNotVersionDowngrade() {
      return resource == null ||
        !('versionCode' in resource.data) ||
        !('versionCode' in request.resource.data) ||
        (request.resource.data.versionCode is number &&
          request.resource.data.versionCode >= 1 &&
          (!(resource.data.versionCode is number) || request.resource.data.versionCode >= resource.data.versionCode));
    }

    function isAllowedErpCollection(col) {
      return col in [
        'user_accounts', 'pending_requests',
        'invoices', 'invoice_items', 'invoice_payments',
        'movements', 'transfers', 'daily_closings',
        'customers', 'products', 'stock_moves',
        'warehouses', 'cashboxes', 'inventory_weights',
        'factory_items', 'factory_machines', 'factory_moves',
        'halfa_invoices', 'poster_prices', 'audit_logs',
        'server_status', 'deleted_users',
        'lab_formulations', 'formulations', 'paint_batches', 'chemical_safety',
        'purchase_orders', 'goods_receipts', 'production_orders', 'qc_inspections', 'fg_receipts', 'sales_deliveries',
        'deleted_records', 'system_metadata', 'system_config', 'app_updates',
        'permission_audit_logs', 'config'
      ];
    }

    // 3. Linked Employee Accounts (/linked_accounts/{accountCode})
    //    Strictly enforces Firebase Authentication, ownerId/linkedUid isolation,
    //    schema validation, and prevents employee privilege escalation.
    match /linked_accounts/{accountCode} {
      function isAccountOwner() {
        return isSignedIn() && resource.data.ownerId == request.auth.uid;
      }

      function isLinkedEmployee() {
        return isSignedIn() && resource.data.linkedUid == request.auth.uid;
      }

      function isValidLinkedAccountCreate(docId) {
        let data = request.resource.data;
        let allowedKeys = [
          'userCode', 'ownerId', 'linkedUid', 'clusterCode', 'fullName', 'username',
          'role', 'branch', 'permissions', 'serverSyncToken',
          'active', 'createdAt', 'updatedAt'
        ];
        return isSignedIn() &&
          isReasonablePayload() &&
          data.keys().hasAll([
            'userCode', 'ownerId', 'linkedUid', 'fullName', 'username',
            'role', 'branch', 'permissions', 'serverSyncToken', 'active', 'createdAt', 'updatedAt'
          ]) &&
          data.keys().hasOnly(allowedKeys) &&
          data.userCode == docId &&
          data.ownerId == request.auth.uid &&
          isNonEmptyString(data.linkedUid, 128) &&
          isNonEmptyString(data.fullName, 120) &&
          isNonEmptyString(data.username, 60) &&
          isNonEmptyString(data.role, 80) &&
          isNonEmptyString(data.branch, 100) &&
          isOptionalString(data.permissions, 2000) &&
          isNonEmptyString(data.serverSyncToken, 120) &&
          (!('clusterCode' in data) || isOptionalString(data.clusterCode, 80)) &&
          data.active is bool &&
          data.createdAt is timestamp &&
          data.updatedAt is timestamp;
      }

      // Tier 1: Account Owner (Admin) updates employee permissions, role, branch, or active status
      function isValidManagerUpdate() {
        let data = request.resource.data;
        return isAccountOwner() &&
          isReasonablePayload() &&
          data.userCode == resource.data.userCode &&
          data.ownerId == resource.data.ownerId &&
          data.createdAt == resource.data.createdAt &&
          isNonEmptyString(data.linkedUid, 128) &&
          isNonEmptyString(data.fullName, 120) &&
          isNonEmptyString(data.username, 60) &&
          isNonEmptyString(data.role, 80) &&
          isNonEmptyString(data.branch, 100) &&
          isOptionalString(data.permissions, 2000) &&
          isNonEmptyString(data.serverSyncToken, 120) &&
          data.active is bool &&
          data.updatedAt is timestamp;
      }

      // Tier 2: Linked Employee updates ONLY sync acknowledgment fields (blocks permissions/role escalation)
      function isValidEmployeeSyncUpdate() {
        let data = request.resource.data;
        let changedKeys = data.diff(resource.data).affectedKeys();
        return isLinkedEmployee() &&
          isReasonablePayload() &&
          changedKeys.hasOnly(['serverSyncToken', 'updatedAt']) &&
          isNonEmptyString(data.serverSyncToken, 120) &&
          data.updatedAt is timestamp;
      }

      allow get: if isAccountOwner() || isLinkedEmployee();
      allow list: if isAccountOwner() || isLinkedEmployee();
      allow create: if isValidId(accountCode) && isValidLinkedAccountCreate(accountCode);
      allow update: if isValidId(accountCode) && (isValidManagerUpdate() || isValidEmployeeSyncUpdate());
      allow delete: if isAccountOwner();
    }

    // 4. Collection Rules: /system_config, /app_updates, /deleted_records, /deleted_accounts
    match /system_config/{docId} {
      allow read: if isValidId(docId);
      allow create, update: if isValidId(docId) && isReasonablePayload() && isNotVersionDowngrade();
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /app_updates/{docId} {
      allow read: if isValidId(docId);
      allow create, update: if isValidId(docId) && isReasonablePayload() && isNotVersionDowngrade();
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /deleted_records/{docId} {
      allow read: if isValidId(docId);
      allow create, update: if isValidId(docId) && isReasonablePayload();
      allow delete: if isSignedIn() && isValidId(docId);
    }

    match /deleted_accounts/{accountCode} {
      allow read: if isValidId(accountCode);
      allow create, update: if isValidId(accountCode) && isReasonablePayload();
      allow delete: if isSignedIn() && isValidId(accountCode);
    }

    match /permission_audit_logs/{logId} {
      allow read: if isSignedIn() && isValidId(logId);
      allow create: if isSignedIn() && isValidId(logId) && isReasonablePayload();
      allow update, delete: if false;
    }

    // 5. Chemical Formulations and Paint Batch Data
    match /lab_formulations/{formulaId} {
      allow read: if isValidId(formulaId);
      allow create, update: if isValidId(formulaId) && isReasonablePayload();
      allow delete: if isSignedIn() && isValidId(formulaId);
    }

    match /paint_batches/{batchId} {
      allow read: if isValidId(batchId);
      allow create, update: if isValidId(batchId) && isReasonablePayload();
      allow delete: if isSignedIn() && isValidId(batchId);
    }

    function isImmutableAuditCollection(col) {
      return col in ['audit_logs', 'permission_audit_logs'];
    }

    function isProtectedTombstoneCollection(col) {
      return col in ['deleted_users', 'deleted_records'];
    }

    function isValidErpDocWrite(col) {
      let d = request.resource.data;
      return isReasonablePayload() &&
        (col != 'invoices' || (
          (!('total' in d) || (d.total is number && d.total >= 0)) &&
          (!('subtotal' in d) || (d.subtotal is number && d.subtotal >= 0)) &&
          (!('discount' in d) || (d.discount is number && d.discount >= 0)) &&
          (!('discountAmount' in d) || (d.discountAmount is number && d.discountAmount >= 0)) &&
          (!('paidAmount' in d) || (d.paidAmount is number && d.paidAmount >= 0)) &&
          (!('customerName' in d) || isNonEmptyString(d.customerName, 200))
        )) &&
        (col != 'invoice_payments' || (
          (!('amount' in d) || (d.amount is number && d.amount > 0))
        )) &&
        (col != 'movements' || (
          (!('amount' in d) || (d.amount is number && d.amount >= 0))
        )) &&
        (col != 'stock_moves' || (
          (!('quantity' in d) || (d.quantity is number && d.quantity >= 0)) &&
          (!('kind' in d) || isNonEmptyString(d.kind, 40))
        )) &&
        (col != 'user_accounts' || (
          (!('username' in d) || isNonEmptyString(d.username, 120)) &&
          (!('active' in d) || d.active is bool)
        ));
    }

    // 6. Hardened ERP Central Clusters Rules (/erp_clusters/{clusterCode})
    match /erp_clusters/{clusterCode} {
      allow get, list: if isValidId(clusterCode);
      allow create, update: if isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isReasonablePayload();
      allow delete: if (isSignedIn() || clusterCode == 'PMP-ERP-V16-CLUSTER') && isValidId(clusterCode);
    }

    match /erp_clusters/{clusterCode}/{collectionName}/{docId} {
      allow get, list: if isValidId(clusterCode) && isAllowedErpCollection(collectionName);
      allow create: if isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isAllowedErpCollection(collectionName) && isValidId(docId) && isValidErpDocWrite(collectionName);
      allow update: if isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isAllowedErpCollection(collectionName) && !isImmutableAuditCollection(collectionName) && isValidId(docId) && isValidErpDocWrite(collectionName);
      allow delete: if isValidId(clusterCode) && isAllowedErpCollection(collectionName) && !isImmutableAuditCollection(collectionName) && (!isProtectedTombstoneCollection(collectionName) || isSignedIn() || clusterCode == 'PMP-ERP-V16-CLUSTER') && isValidId(docId);
    }

    match /erp_clusters/{clusterCode}/{collectionName}/{docId}/{subCollection}/{subDocId} {
      allow get, list: if isValidId(clusterCode) && isAllowedErpCollection(collectionName) && isValidId(docId);
      allow create: if isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isAllowedErpCollection(collectionName) && isValidId(docId) && isValidId(subDocId) && isReasonablePayload();
      allow update, delete: if isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isAllowedErpCollection(collectionName) && !isImmutableAuditCollection(collectionName) && isValidId(docId) && isValidId(subDocId) && isReasonablePayload();
    }
  }
}
