    // 8. Hardened ERP Central Clusters Rules (/erp_clusters/{clusterCode})
    match /erp_clusters/{clusterCode} {
      allow get, list: if isNonAnonymousAuth() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isActiveClusterMember(clusterCode);
      allow create: if isNonAnonymousAuth() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isReasonablePayload() &&
        (isClusterAdmin(clusterCode) || !exists(ownerLockPath(clusterCode)));
      allow update: if isNonAnonymousAuth() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isReasonablePayload() && isClusterAdmin(clusterCode);
      allow delete: if isNonAnonymousAuth() && isValidId(clusterCode) && isClusterAdmin(clusterCode);
    }

    // 8a. Authoritative Cluster RBAC Directory (/cluster_members/{uid})
    function isOwnerLockHolder(clusterCode) {
      let lock = get(ownerLockPath(clusterCode)).data;
      return ('ownerUid' in lock) && lock.ownerUid == request.auth.uid;
    }

    function matchesEmailDirectoryClaim(clusterCode, emailKey) {
      let d = request.resource.data;
