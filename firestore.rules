rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() >= 1 && val.size() <= maxLen;
    }

    function isOptionalString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isReasonablePayload() {
      return request.resource == null || request.resource.data.keys().size() <= 120;
    }

    function isNotVersionDowngrade() {
      return resource == null ||
        !('versionCode' in resource.data) ||
        !('versionCode' in request.resource.data) ||
        (request.resource.data.versionCode is number &&
          request.resource.data.versionCode >= 1 &&
          (!(resource.data.versionCode is number) || request.resource.data.versionCode >= resource.data.versionCode));
    }

    // 3. Enterprise Cluster Membership & RBAC Helpers (Single-Lookup, Zero-Trust)
    function memberPath(clusterCode, uid) {
      return /databases/$(database)/documents/erp_clusters/$(clusterCode)/cluster_members/$(uid);
    }

    function emailDirPath(clusterCode, emailKey) {
      return /databases/$(database)/documents/erp_clusters/$(clusterCode)/email_directory/$(emailKey);
    }

    function ownerLockPath(clusterCode) {
      return /databases/$(database)/documents/erp_clusters/$(clusterCode)/system_metadata/cluster_owner;
    }

    function hasTokenRoleClaim(clusterCode) {
      return isSignedIn() &&
        ('roleKey' in request.auth.token) &&
        request.auth.token.roleKey in ['ADMIN', 'MANAGER', 'ACCOUNTANT', 'DEPUTY_ACCOUNTANT', 'EMPLOYEE'] &&
        (!('clusterCode' in request.auth.token) || request.auth.token.clusterCode == clusterCode);
    }

    function resolveMember(clusterCode) {
      return (isSignedIn() && exists(memberPath(clusterCode, request.auth.uid)))
        ? get(memberPath(clusterCode, request.auth.uid)).data
        : (hasTokenRoleClaim(clusterCode)
            ? {'roleKey': request.auth.token.roleKey, 'branch': 'ALL', 'active': true, 'userCode': ''}
            : {'roleKey': 'NONE', 'branch': '', 'active': false, 'userCode': ''});
    }

    function isMemberAdmin(m) {
      return m.active == true && m.roleKey == 'ADMIN';
    }

    function isMemberManager(m) {
      return m.active == true && m.roleKey == 'MANAGER';
    }

    function isMemberAccountant(m) {
      return m.active == true && m.roleKey == 'ACCOUNTANT';
    }

    function isMemberDeputyAccountant(m) {
      return m.active == true && m.roleKey == 'DEPUTY_ACCOUNTANT';
    }

    function isClusterAdmin(clusterCode) {
      let m = resolveMember(clusterCode);
      return isSignedIn() && m.active == true && m.roleKey == 'ADMIN';
    }

    function isClusterManager(clusterCode) {
      let m = resolveMember(clusterCode);
      return isSignedIn() && m.active == true && m.roleKey == 'MANAGER';
    }

    function isActiveClusterMember(clusterCode) {
      let m = resolveMember(clusterCode);
      return isSignedIn() && m.active == true && m.roleKey in ['ADMIN', 'MANAGER', 'ACCOUNTANT', 'DEPUTY_ACCOUNTANT', 'EMPLOYEE'];
    }

    function isGlobalBranchValue(branchVal) {
      return !(branchVal is string) ||
        branchVal.size() == 0 ||
        branchVal in ['ALL', 'الكل', 'الإدارة العامة', 'جميع الفروع'];
    }

    function canMemberAccessBranch(m, branchVal) {
      return isMemberAdmin(m) ||
        !('branch' in m) ||
        isGlobalBranchValue(m.branch) ||
        isGlobalBranchValue(branchVal) ||
        branchVal == m.branch;
    }

    function isPrivilegedArabicOrEnRole(roleStr) {
      return roleStr is string && (
        roleStr.matches('.*(مدير النظام|المدير العام|Super\\s*Admin|SUPER_ADMIN|ADMIN|Manager|المدير|مشرف).*')
      );
    }

    function isValidRoleKey(rk) {
      return rk in ['ADMIN', 'MANAGER', 'ACCOUNTANT', 'DEPUTY_ACCOUNTANT', 'EMPLOYEE'];
    }

    function isAllowedErpCollection(col) {
      return col in [
        'user_accounts', 'pending_requests',
        'invoices', 'invoice_items', 'invoice_payments',
        'movements', 'transfers', 'daily_closings',
        'customers', 'products', 'stock_moves',
        'warehouses', 'cashboxes', 'inventory_weights',
        'factory_items', 'factory_machines', 'factory_moves',
        'halfa_invoices', 'poster_prices', 'audit_logs',
        'server_status', 'deleted_users',
        'lab_formulations', 'formulations', 'paint_batches', 'chemical_safety',
        'purchase_orders', 'purchase_receipts', 'goods_receipts', 'production_orders', 'qc_inspections', 'fg_receipts', 'sales_deliveries',
        'inventory_movements', 'warehouse_stock_balances', 'warehouse_transfers', 'warehouse_transfer_items', 'packaging_rules', 'stock_batches',
        'accounting_accounts', 'journal_entries', 'journal_lines',
        'deleted_records', 'system_metadata', 'system_config', 'app_updates',
        'permission_audit_logs', 'config',
        'idempotency_requests'
      ];
    }

    // 4. Linked Employee Accounts (/linked_accounts/{accountCode})
    //    Strictly enforces Firebase Authentication, ownerId/linkedUid isolation,
    //    schema validation, and prevents employee privilege escalation.
    match /linked_accounts/{accountCode} {
      function isAccountOwner() {
        return isSignedIn() && resource.data.ownerId == request.auth.uid;
      }

      function isLinkedEmployee() {
        return isSignedIn() && resource.data.linkedUid == request.auth.uid;
      }

      function isValidLinkedAccountCreate(docId) {
        let data = request.resource.data;
        let allowedKeys = [
          'userCode', 'ownerId', 'linkedUid', 'clusterCode', 'fullName', 'username',
          'role', 'branch', 'permissions', 'serverSyncToken',
          'active', 'createdAt', 'updatedAt'
        ];
        return isSignedIn() &&
          isReasonablePayload() &&
          data.keys().hasAll([
            'userCode', 'ownerId', 'linkedUid', 'fullName', 'username',
            'role', 'branch', 'permissions', 'serverSyncToken', 'active', 'createdAt', 'updatedAt'
          ]) &&
          data.keys().hasOnly(allowedKeys) &&
          data.userCode == docId &&
          data.ownerId == request.auth.uid &&
          isNonEmptyString(data.linkedUid, 128) &&
          isNonEmptyString(data.fullName, 120) &&
          isNonEmptyString(data.username, 60) &&
          isNonEmptyString(data.role, 80) &&
          isNonEmptyString(data.branch, 100) &&
          isOptionalString(data.permissions, 2000) &&
          isNonEmptyString(data.serverSyncToken, 120) &&
          (!('clusterCode' in data) || isOptionalString(data.clusterCode, 80)) &&
          data.active is bool &&
          data.createdAt is timestamp &&
          data.updatedAt is timestamp;
      }

      // Tier 1: Account Owner (Admin) updates employee permissions, role, branch, or active status
      function isValidManagerUpdate() {
        let data = request.resource.data;
        return isAccountOwner() &&
          isReasonablePayload() &&
          data.userCode == resource.data.userCode &&
          data.ownerId == resource.data.ownerId &&
          data.createdAt == resource.data.createdAt &&
          isNonEmptyString(data.linkedUid, 128) &&
          isNonEmptyString(data.fullName, 120) &&
          isNonEmptyString(data.username, 60) &&
          isNonEmptyString(data.role, 80) &&
          isNonEmptyString(data.branch, 100) &&
          isOptionalString(data.permissions, 2000) &&
          isNonEmptyString(data.serverSyncToken, 120) &&
          data.active is bool &&
          data.updatedAt is timestamp;
      }

      // Tier 2: Linked Employee updates ONLY sync acknowledgment fields (blocks permissions/role escalation)
      function isValidEmployeeSyncUpdate() {
        let data = request.resource.data;
        let changedKeys = data.diff(resource.data).affectedKeys();
        return isLinkedEmployee() &&
          isReasonablePayload() &&
          changedKeys.hasOnly(['serverSyncToken', 'updatedAt']) &&
          isNonEmptyString(data.serverSyncToken, 120) &&
          data.updatedAt is timestamp;
      }

      allow get: if isAccountOwner() || isLinkedEmployee();
      allow list: if isAccountOwner() || isLinkedEmployee();
      allow create: if isValidId(accountCode) && isValidLinkedAccountCreate(accountCode);
      allow update: if isValidId(accountCode) && (isValidManagerUpdate() || isValidEmployeeSyncUpdate());
      allow delete: if isAccountOwner();
    }

    // 5. Root Configuration, Updates & Tombstones (Hardened Auth & Role Scopes)
    match /system_config/{docId} {
      allow read: if isValidId(docId);
      allow create, update: if isSignedIn() && isValidId(docId) && isReasonablePayload() && isNotVersionDowngrade() && isClusterAdmin('PMP-ERP-MAIN-CLUSTER');
      allow delete: if isSignedIn() && isValidId(docId) && isClusterAdmin('PMP-ERP-MAIN-CLUSTER');
    }

    match /app_updates/{docId} {
      allow read: if isValidId(docId);
      allow create, update: if isSignedIn() && isValidId(docId) && isReasonablePayload() && isNotVersionDowngrade() && isClusterAdmin('PMP-ERP-MAIN-CLUSTER');
      allow delete: if isSignedIn() && isValidId(docId) && isClusterAdmin('PMP-ERP-MAIN-CLUSTER');
    }

    match /deleted_records/{docId} {
      allow read: if isSignedIn() && isValidId(docId) && isActiveClusterMember('PMP-ERP-MAIN-CLUSTER');
      allow create, update: if isSignedIn() && isValidId(docId) && isReasonablePayload() && (isClusterAdmin('PMP-ERP-MAIN-CLUSTER') || isClusterManager('PMP-ERP-MAIN-CLUSTER'));
      allow delete: if isSignedIn() && isValidId(docId) && isClusterAdmin('PMP-ERP-MAIN-CLUSTER');
    }

    match /deleted_accounts/{accountCode} {
      allow read: if isSignedIn() && isValidId(accountCode) && isActiveClusterMember('PMP-ERP-MAIN-CLUSTER');
      allow create, update: if isSignedIn() && isValidId(accountCode) && isReasonablePayload() && (isClusterAdmin('PMP-ERP-MAIN-CLUSTER') || isClusterManager('PMP-ERP-MAIN-CLUSTER'));
      allow delete: if isSignedIn() && isValidId(accountCode) && isClusterAdmin('PMP-ERP-MAIN-CLUSTER');
    }

    match /permission_audit_logs/{logId} {
      allow read: if isSignedIn() && isValidId(logId) && (isClusterAdmin('PMP-ERP-MAIN-CLUSTER') || isClusterManager('PMP-ERP-MAIN-CLUSTER'));
      allow create: if isSignedIn() && isValidId(logId) && isReasonablePayload() && (isClusterAdmin('PMP-ERP-MAIN-CLUSTER') || isClusterManager('PMP-ERP-MAIN-CLUSTER'));
      allow update, delete: if false;
    }

    // 6. Chemical Formulations and Paint Batch Data (Requires Authenticated Cluster Member)
    match /lab_formulations/{formulaId} {
      allow read: if isSignedIn() && isValidId(formulaId) && isActiveClusterMember('PMP-ERP-MAIN-CLUSTER');
      allow create, update: if isSignedIn() && isValidId(formulaId) && isReasonablePayload() && isActiveClusterMember('PMP-ERP-MAIN-CLUSTER');
      allow delete: if isSignedIn() && isValidId(formulaId) && (isClusterAdmin('PMP-ERP-MAIN-CLUSTER') || isClusterManager('PMP-ERP-MAIN-CLUSTER'));
    }

    match /paint_batches/{batchId} {
      allow read: if isSignedIn() && isValidId(batchId) && isActiveClusterMember('PMP-ERP-MAIN-CLUSTER');
      allow create, update: if isSignedIn() && isValidId(batchId) && isReasonablePayload() && isActiveClusterMember('PMP-ERP-MAIN-CLUSTER');
      allow delete: if isSignedIn() && isValidId(batchId) && (isClusterAdmin('PMP-ERP-MAIN-CLUSTER') || isClusterManager('PMP-ERP-MAIN-CLUSTER'));
    }

    // 7. Collection Semantics & Payload Validation Helpers
    function isImmutableAuditCollection(col) {
      return col in ['audit_logs', 'permission_audit_logs'];
    }

    function isAppendOnlyMovementCollection(col) {
      return col in ['inventory_movements', 'journal_entries'];
    }

    function isImmutableJournalLineCollection(col) {
      return col == 'journal_lines';
    }

    function isIdempotencyCollection(col) {
      return col == 'idempotency_requests';
    }

    function isValidErpDocWrite(col) {
      let d = request.resource.data;
      return isReasonablePayload() &&
        (col != 'invoices' || (
          (!('total' in d) || (d.total is number && d.total >= 0)) &&
          (!('subtotal' in d) || (d.subtotal is number && d.subtotal >= 0)) &&
          (!('discount' in d) || (d.discount is number && d.discount >= 0)) &&
          (!('discountAmount' in d) || (d.discountAmount is number && d.discountAmount >= 0)) &&
          (!('paidAmount' in d) || (d.paidAmount is number && d.paidAmount >= 0)) &&
          (!('customerName' in d) || isNonEmptyString(d.customerName, 200))
        )) &&
        (col != 'invoice_payments' || (!('amount' in d) || (d.amount is number && d.amount > 0))) &&
        (col != 'movements' || (
          (!('amount' in d) || (d.amount is number && d.amount >= 0)) &&
          (!('direction' in d) || d.direction in ['وارد', 'منصرف', 'IN', 'OUT', 'INCOME', 'EXPENSE', 'TRANSFER_IN', 'TRANSFER_OUT', 'قبض', 'صرف']) &&
          (!('currency' in d) || d.currency in ['SDG', 'EGP', 'USD']) &&
          (!('cashbox' in d) || isNonEmptyString(d.cashbox, 120))
        )) &&
        (col != 'transfers' || (
          (!('sourceAmount' in d) || (d.sourceAmount is number && d.sourceAmount >= 0)) &&
          (!('destinationAmount' in d) || (d.destinationAmount is number && d.destinationAmount >= 0)) &&
          (!('rate' in d) || (d.rate is number && d.rate > 0))
        )) &&
        (col != 'deleted_records' || (
          isNonEmptyString(d.collection, 64) &&
          ((('docId' in d) && isNonEmptyString(d.docId, 160)) || (('entityId' in d) && isNonEmptyString(d.entityId, 160)))
        )) &&
        (col != 'stock_moves' || (
          (!('quantity' in d) || (d.quantity is number && d.quantity >= 0)) &&
          (!('kind' in d) || isNonEmptyString(d.kind, 40))
        )) &&
        (col != 'inventory_movements' || (
          (!('quantity' in d) || (d.quantity is number && d.quantity > 0)) &&
          (!('movementType' in d) || isNonEmptyString(d.movementType, 60))
        )) &&
        (col != 'warehouse_stock_balances' || (
          (!('onHandQty' in d) || (d.onHandQty is number && d.onHandQty >= 0)) &&
          (!('availableQty' in d) || (d.availableQty is number && d.availableQty >= 0))
        )) &&
        (col != 'packaging_rules' || (
          (!('weightGrams' in d) || (d.weightGrams is number && d.weightGrams > 0)) &&
          (!('cansPerCarton' in d) || (d.cansPerCarton is number && d.cansPerCarton > 0))
        )) &&
        (col != 'purchase_receipts' || (
          (!('receivedQty' in d) || (d.receivedQty is number && d.receivedQty > 0)) &&
          (!('acceptedQty' in d) || (d.acceptedQty is number && d.acceptedQty >= 0)) &&
          (!('rejectedQty' in d) || (d.rejectedQty is number && d.rejectedQty >= 0))
        )) &&
        (col != 'production_orders' || (
          (!('targetCartons' in d) || (d.targetCartons is number && d.targetCartons > 0)) &&
          (!('packageWeightGrams' in d) || (d.packageWeightGrams is number && d.packageWeightGrams > 0))
        )) &&
        (col != 'qc_inspections' || (
          (!('inspectedQty' in d) || (d.inspectedQty is number && d.inspectedQty > 0)) &&
          (!('acceptedQty' in d) || (d.acceptedQty is number && d.acceptedQty >= 0)) &&
          (!('rejectedQty' in d) || (d.rejectedQty is number && d.rejectedQty >= 0))
        )) &&
        (col != 'user_accounts' || (
          (!('username' in d) || isNonEmptyString(d.username, 120)) &&
          (!('active' in d) || d.active is bool)
        )) &&
        (col != 'accounting_accounts' || (
          (!('accountCode' in d) || isNonEmptyString(d.accountCode, 32)) &&
          (!('nameAr' in d) || isNonEmptyString(d.nameAr, 160))
        )) &&
        (col != 'journal_entries' || (
          (!('totalDebit' in d) || (d.totalDebit is number && d.totalDebit >= 0)) &&
          (!('totalCredit' in d) || (d.totalCredit is number && d.totalCredit >= 0)) &&
          (!('totalDebit' in d) || !('totalCredit' in d) || (d.totalDebit - d.totalCredit < 0.001 && d.totalCredit - d.totalDebit < 0.001))
        )) &&
        (col != 'journal_lines' || (
          (!('debit' in d) || (d.debit is number && d.debit >= 0)) &&
          (!('credit' in d) || (d.credit is number && d.credit >= 0))
        ));
    }

    // Single-lookup Collection-level Role Authorization Matrices
    function canReadErpCollection(clusterCode, col) {
      let m = resolveMember(clusterCode);
      return isSignedIn() && m.active == true && m.roleKey in ['ADMIN', 'MANAGER', 'ACCOUNTANT', 'DEPUTY_ACCOUNTANT', 'EMPLOYEE'] && (
        isMemberAdmin(m) ||
        (col in ['system_config', 'system_metadata', 'config'] && (isMemberManager(m) || isMemberAccountant(m))) ||
        (!(col in ['system_config', 'system_metadata', 'config']) && (
          !('branch' in resource.data) || canMemberAccessBranch(m, resource.data.branch)
        ))
      );
    }

    function canCreateErpCollection(clusterCode, col) {
      let m = resolveMember(clusterCode);
      let d = request.resource.data;
      return isSignedIn() && m.active == true && m.roleKey in ['ADMIN', 'MANAGER', 'ACCOUNTANT', 'DEPUTY_ACCOUNTANT', 'EMPLOYEE'] && (
        isMemberAdmin(m) ||
        (col in ['system_metadata', 'system_config', 'app_updates', 'config'] && false) ||
        (col in ['deleted_records', 'deleted_users', 'permission_audit_logs'] && isMemberManager(m)) ||
        (col == 'accounting_accounts' && (isMemberManager(m) || isMemberAccountant(m))) ||
        (col in ['journal_entries', 'journal_lines'] && (isMemberManager(m) || isMemberAccountant(m) || isMemberDeputyAccountant(m))) ||
        (col in ['cashboxes', 'movements', 'transfers', 'daily_closings'] &&
          (isMemberManager(m) || isMemberAccountant(m) || isMemberDeputyAccountant(m)) &&
          (!('branch' in d) || canMemberAccessBranch(m, d.branch))) ||
        (!(col in ['system_metadata', 'system_config', 'app_updates', 'config', 'deleted_records', 'deleted_users', 'permission_audit_logs', 'accounting_accounts', 'journal_entries', 'journal_lines', 'cashboxes', 'movements', 'transfers', 'daily_closings']) &&
          (!('branch' in d) || canMemberAccessBranch(m, d.branch)))
      );
    }

    function canUpdateErpCollection(clusterCode, col) {
      let m = resolveMember(clusterCode);
      let d = request.resource.data;
      return isSignedIn() && m.active == true && m.roleKey in ['ADMIN', 'MANAGER', 'ACCOUNTANT', 'DEPUTY_ACCOUNTANT', 'EMPLOYEE'] && (
        isMemberAdmin(m) ||
        (col in ['system_metadata', 'system_config', 'app_updates', 'config', 'deleted_users'] && false) ||
        (col == 'deleted_records' && isMemberManager(m)) ||
        (col == 'journal_entries' && isMemberAccountant(m)) ||
        (col == 'inventory_movements' && (isMemberManager(m) || isMemberAccountant(m))) ||
        (col == 'accounting_accounts' && (isMemberManager(m) || isMemberAccountant(m))) ||
        (col in ['cashboxes', 'movements', 'transfers', 'daily_closings'] &&
          (isMemberManager(m) || isMemberAccountant(m) || isMemberDeputyAccountant(m)) &&
          (!('branch' in d) || canMemberAccessBranch(m, d.branch)) &&
          (!('branch' in resource.data) || canMemberAccessBranch(m, resource.data.branch))) ||
        (!(col in ['system_metadata', 'system_config', 'app_updates', 'config', 'deleted_records', 'deleted_users', 'journal_entries', 'inventory_movements', 'accounting_accounts', 'cashboxes', 'movements', 'transfers', 'daily_closings']) &&
          (isMemberManager(m) || isMemberAccountant(m) || isMemberDeputyAccountant(m) || !(col in ['warehouses', 'products', 'packaging_rules'])) &&
          (!('branch' in d) || canMemberAccessBranch(m, d.branch)) &&
          (!('branch' in resource.data) || canMemberAccessBranch(m, resource.data.branch)))
      );
    }

    function canDeleteErpCollection(clusterCode, col) {
      let m = resolveMember(clusterCode);
      return isSignedIn() && m.active == true && m.roleKey in ['ADMIN', 'MANAGER', 'ACCOUNTANT', 'DEPUTY_ACCOUNTANT', 'EMPLOYEE'] && (
        isMemberAdmin(m) ||
        (!(col in ['system_metadata', 'system_config', 'app_updates', 'config', 'deleted_records', 'deleted_users', 'cashboxes', 'warehouses', 'accounting_accounts']) &&
          isMemberManager(m) &&
          (!('branch' in resource.data) || canMemberAccessBranch(m, resource.data.branch)))
      );
    }

    // 8. Hardened ERP Central Clusters Rules (/erp_clusters/{clusterCode})
    match /erp_clusters/{clusterCode} {
      allow get, list: if isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isActiveClusterMember(clusterCode);
      allow create: if isSignedIn() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isReasonablePayload() &&
        (isClusterAdmin(clusterCode) || !exists(ownerLockPath(clusterCode)));
      allow update: if isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isReasonablePayload() && isClusterAdmin(clusterCode);
      allow delete: if isValidId(clusterCode) && isClusterAdmin(clusterCode);
    }

    // 8a. Authoritative Cluster RBAC Directory (/cluster_members/{uid})
    match /erp_clusters/{clusterCode}/cluster_members/{memberUid} {
      allow get: if isSignedIn() && isValidId(clusterCode) && isValidId(memberUid) && (
        request.auth.uid == memberUid || isClusterAdmin(clusterCode) || isClusterManager(clusterCode)
      );
      allow list: if isValidId(clusterCode) && (isClusterAdmin(clusterCode) || isClusterManager(clusterCode));
      allow create: if isSignedIn() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isValidId(memberUid) &&
        isReasonablePayload() && isValidRoleKey(request.resource.data.roleKey) && request.resource.data.active is bool && (
          isClusterAdmin(clusterCode) ||
          (isClusterManager(clusterCode) &&
            request.auth.uid != memberUid &&
            request.resource.data.roleKey in ['ACCOUNTANT', 'DEPUTY_ACCOUNTANT', 'EMPLOYEE']) ||
          (request.auth.uid == memberUid &&
            request.resource.data.uid == request.auth.uid &&
            request.resource.data.roleKey == 'ADMIN' &&
            request.resource.data.active == true &&
            !exists(ownerLockPath(clusterCode))) ||
          (request.auth.uid == memberUid &&
            request.auth.token.email_verified == true &&
            isNonEmptyString(request.resource.data.emailKey, 128) &&
            exists(emailDirPath(clusterCode, request.resource.data.emailKey)) &&
            get(emailDirPath(clusterCode, request.resource.data.emailKey)).data.email == request.auth.token.email &&
            get(emailDirPath(clusterCode, request.resource.data.emailKey)).data.active == true &&
            request.resource.data.uid == request.auth.uid &&
            request.resource.data.roleKey == get(emailDirPath(clusterCode, request.resource.data.emailKey)).data.roleKey &&
            request.resource.data.branch == get(emailDirPath(clusterCode, request.resource.data.emailKey)).data.branch &&
            request.resource.data.permissions == get(emailDirPath(clusterCode, request.resource.data.emailKey)).data.permissions &&
            request.resource.data.userCode == get(emailDirPath(clusterCode, request.resource.data.emailKey)).data.userCode &&
            request.resource.data.active == true)
        );
      allow update: if isSignedIn() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isValidId(memberUid) &&
        isReasonablePayload() && isValidRoleKey(request.resource.data.roleKey) && request.resource.data.active is bool && (
          (request.auth.uid == memberUid &&
            isActiveClusterMember(clusterCode) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt', 'updatedAt', 'deviceId', 'serverUpdatedAt'])) ||
          (isClusterAdmin(clusterCode) && request.auth.uid != memberUid) ||
          (isClusterManager(clusterCode) &&
            request.auth.uid != memberUid &&
            !(resource.data.roleKey in ['ADMIN', 'MANAGER']) &&
            request.resource.data.roleKey in ['ACCOUNTANT', 'DEPUTY_ACCOUNTANT', 'EMPLOYEE'])
        );
      allow delete: if isSignedIn() && isValidId(clusterCode) && isValidId(memberUid) && request.auth.uid != memberUid && (
        isClusterAdmin(clusterCode) ||
        (isClusterManager(clusterCode) && !(resource.data.roleKey in ['ADMIN', 'MANAGER']))
      );
    }

    // 8b. Pre-provisioned Email Directory (/email_directory/{emailKey})
    match /erp_clusters/{clusterCode}/email_directory/{emailKey} {
      allow get: if isSignedIn() && isValidId(clusterCode) && isValidId(emailKey) && (
        isClusterAdmin(clusterCode) ||
        isClusterManager(clusterCode) ||
        (request.auth.token.email_verified == true && resource != null && resource.data.email == request.auth.token.email)
      );
      allow list: if isValidId(clusterCode) && (isClusterAdmin(clusterCode) || isClusterManager(clusterCode));
      allow create, update: if isSignedIn() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isValidId(emailKey) &&
        isReasonablePayload() && isValidRoleKey(request.resource.data.roleKey) && (
          isClusterAdmin(clusterCode) ||
          (isClusterManager(clusterCode) &&
            request.resource.data.roleKey in ['ACCOUNTANT', 'DEPUTY_ACCOUNTANT', 'EMPLOYEE'] &&
            request.resource.data.email != request.auth.token.email &&
            (resource == null || !(resource.data.roleKey in ['ADMIN', 'MANAGER'])))
        );
      allow delete: if isValidId(clusterCode) && isValidId(emailKey) && (
        isClusterAdmin(clusterCode) ||
        (isClusterManager(clusterCode) && !(resource.data.roleKey in ['ADMIN', 'MANAGER']))
      );
    }

    // 8c. Immutable Cluster Owner Bootstrap Lock (/system_metadata/cluster_owner)
    match /erp_clusters/{clusterCode}/system_metadata/cluster_owner {
      allow get: if isSignedIn() && isValidId(clusterCode);
      allow list: if isClusterAdmin(clusterCode);
      allow create: if isSignedIn() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' &&
        !exists(ownerLockPath(clusterCode)) &&
        request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }

    // 8d. User Accounts, Pending Requests, and Idempotency Requests (Dedicated Low-Expression Rules)
    match /erp_clusters/{clusterCode}/user_accounts/{docId} {
      allow get: if isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isSignedIn() && (
        isClusterAdmin(clusterCode) ||
        isClusterManager(clusterCode) ||
        (isActiveClusterMember(clusterCode) && (
          resource.data.linkedUid == request.auth.uid ||
          resource.data.userCode == resolveMember(clusterCode).userCode ||
          (request.auth.token.email != null && resource.data.phoneOrEmail == request.auth.token.email)
        ))
      );
      allow list: if isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && (
        isClusterAdmin(clusterCode) || isClusterManager(clusterCode)
      );
      allow create: if isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isValidId(docId) && isValidErpDocWrite('user_accounts') && (
        isClusterAdmin(clusterCode) ||
        (functionCreateUserByManager(clusterCode))
      );
      allow update: if isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isValidId(docId) && isValidErpDocWrite('user_accounts') && (
        functionUpdateUserAccount(clusterCode)
      );
      allow delete: if isValidId(clusterCode) && isValidId(docId) &&
        resource.data.userCode != 'USR-ADMIN' &&
        resource.data.username != 'admin' &&
        resource.data.linkedUid != request.auth.uid && (
          isClusterAdmin(clusterCode) ||
          (isClusterManager(clusterCode) && !isPrivilegedArabicOrEnRole(resource.data.role))
        );
    }

    function functionCreateUserByManager(clusterCode) {
      let m = resolveMember(clusterCode);
      return isSignedIn() && isMemberManager(m) &&
        !isPrivilegedArabicOrEnRole(request.resource.data.role) &&
        canMemberAccessBranch(m, request.resource.data.branch);
    }

    function functionUpdateUserAccount(clusterCode) {
      let m = resolveMember(clusterCode);
      let d = request.resource.data;
      let isSelf = (resource.data.linkedUid == request.auth.uid || (m.userCode != '' && resource.data.userCode == m.userCode));
      return isSignedIn() && m.active == true && (
        (isSelf && m.roleKey in ['ADMIN', 'MANAGER', 'ACCOUNTANT', 'DEPUTY_ACCOUNTANT', 'EMPLOYEE'] &&
          d.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phoneOrEmail', 'pinOrPassword', 'serverSyncToken', 'lastLoginAt', 'deviceId', 'updatedAt', 'serverUpdatedAt'])) ||
        (isMemberAdmin(m) && !isSelf) ||
        (isMemberManager(m) && !isSelf &&
          !isPrivilegedArabicOrEnRole(resource.data.role) &&
          !isPrivilegedArabicOrEnRole(d.role) &&
          canMemberAccessBranch(m, d.branch))
      );
    }

    match /erp_clusters/{clusterCode}/pending_requests/{docId} {
      allow get: if isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isSignedIn() && (
        isClusterAdmin(clusterCode) ||
        isClusterManager(clusterCode) ||
        resource.data.linkedUid == request.auth.uid ||
        (request.auth.token.email != null && resource.data.phoneOrEmail == request.auth.token.email)
      );
      allow list: if isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && (
        isClusterAdmin(clusterCode) || isClusterManager(clusterCode)
      );
      allow create: if isSignedIn() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isValidId(docId) && isReasonablePayload() && (
        isClusterAdmin(clusterCode) ||
        isClusterManager(clusterCode) ||
        (request.resource.data.syncStatus == 'PENDING_MANAGER_APPROVAL' &&
          request.resource.data.active == false &&
          !isPrivilegedArabicOrEnRole(request.resource.data.role) &&
          (!('permissions' in request.resource.data) || request.resource.data.permissions == '' || request.resource.data.permissions == 'صلاحية العرض'))
      );
      allow update, delete: if isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isValidId(docId) && (
        isClusterAdmin(clusterCode) || isClusterManager(clusterCode)
      );
    }

    match /erp_clusters/{clusterCode}/idempotency_requests/{docId} {
      function isValidIdemDoc() {
        let d = request.resource.data;
        return isReasonablePayload() &&
          isNonEmptyString(d.idempotencyKey, 128) &&
          isNonEmptyString(d.operationType, 80) &&
          d.requestStatus in ['DRAFT', 'PROCESSING', 'PENDING_CONFIRMATION', 'COMPLETED', 'FAILED', 'CANCELLED'] &&
          (!('resultReference' in d) || d.resultReference == null || isOptionalString(d.resultReference, 256)) &&
          (!('errorDetails' in d) || d.errorDetails == null || isOptionalString(d.errorDetails, 1000));
      }
      allow get, list: if isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isActiveClusterMember(clusterCode);
      allow create: if isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isValidId(docId) && isActiveClusterMember(clusterCode) && isValidIdemDoc();
      allow update: if isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isValidId(docId) && isActiveClusterMember(clusterCode) && isValidIdemDoc() &&
        resource.data.requestStatus != 'COMPLETED' &&
        request.resource.data.idempotencyKey == resource.data.idempotencyKey &&
        request.resource.data.operationType == resource.data.operationType;
      allow delete: if false;
    }

    // 8e. Operational ERP Collections inside Cluster
    match /erp_clusters/{clusterCode}/{collectionName}/{docId} {
      allow get, list: if isValidId(clusterCode) &&
        clusterCode != 'PMP-ERP-V16-CLUSTER' &&
        isAllowedErpCollection(collectionName) &&
        !(collectionName in ['user_accounts', 'pending_requests', 'idempotency_requests']) &&
        canReadErpCollection(clusterCode, collectionName);

      allow create: if isValidId(clusterCode) &&
        clusterCode != 'PMP-ERP-V16-CLUSTER' &&
        isAllowedErpCollection(collectionName) &&
        !(collectionName in ['user_accounts', 'pending_requests', 'idempotency_requests']) &&
        isValidId(docId) &&
        isValidErpDocWrite(collectionName) &&
        canCreateErpCollection(clusterCode, collectionName);

      allow update: if isValidId(clusterCode) &&
        clusterCode != 'PMP-ERP-V16-CLUSTER' &&
        isAllowedErpCollection(collectionName) &&
        !(collectionName in ['user_accounts', 'pending_requests', 'idempotency_requests']) &&
        !isImmutableAuditCollection(collectionName) &&
        !isImmutableJournalLineCollection(collectionName) &&
        isValidId(docId) &&
        isValidErpDocWrite(collectionName) &&
        canUpdateErpCollection(clusterCode, collectionName) &&
        (!isAppendOnlyMovementCollection(collectionName) || (
          request.resource.data.status == 'REVERSED' &&
          resource.data.status == 'POSTED' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reversedByEntryNo', 'reversalReason', 'recordVersion', 'updatedAt', 'serverUpdatedAt', 'serverUpdatedBy'])
        ));

      allow delete: if isValidId(clusterCode) &&
        clusterCode != 'PMP-ERP-V16-CLUSTER' &&
        isAllowedErpCollection(collectionName) &&
        !(collectionName in ['user_accounts', 'pending_requests', 'idempotency_requests']) &&
        !isImmutableAuditCollection(collectionName) &&
        !isAppendOnlyMovementCollection(collectionName) &&
        !isImmutableJournalLineCollection(collectionName) &&
        isValidId(docId) &&
        canDeleteErpCollection(clusterCode, collectionName);
    }

    match /erp_clusters/{clusterCode}/{collectionName}/{docId}/{subCollection}/{subDocId} {
      allow get, list: if isValidId(clusterCode) &&
        clusterCode != 'PMP-ERP-V16-CLUSTER' &&
        isAllowedErpCollection(collectionName) &&
        isValidId(docId) &&
        isActiveClusterMember(clusterCode);

      allow create: if isValidId(clusterCode) &&
        clusterCode != 'PMP-ERP-V16-CLUSTER' &&
        isAllowedErpCollection(collectionName) &&
        isValidId(docId) &&
        isValidId(subDocId) &&
        isReasonablePayload() &&
        canCreateErpCollection(clusterCode, collectionName);

      allow update, delete: if isValidId(clusterCode) &&
        clusterCode != 'PMP-ERP-V16-CLUSTER' &&
        isAllowedErpCollection(collectionName) &&
        !isImmutableAuditCollection(collectionName) &&
        !isAppendOnlyMovementCollection(collectionName) &&
        !isImmutableJournalLineCollection(collectionName) &&
        !isIdempotencyCollection(collectionName) &&
        isValidId(docId) &&
        isValidId(subDocId) &&
        isReasonablePayload() &&
        canDeleteErpCollection(clusterCode, collectionName);
    }
  }
}
