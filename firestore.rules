rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: /linked_accounts/{accountCode}
    //   - userCode: string (1..128, immutable, == docId)
    //   - ownerId: string (1..128, immutable, == creator uid)
    //   - linkedUid: string (1..128)
    //   - clusterCode: string (optional, <= 80, immutable after create)
    //   - fullName, username, role, branch, permissions, serverSyncToken: string (bounded)
    //   - active: bool
    //   - createdAt (immutable), updatedAt: timestamp
    //
    // Collection: /erp_clusters/{clusterCode}/cluster_members/{memberUid}
    //   - uid: string (== memberUid, immutable)
    //   - userCode, username, fullName, email, emailKey, branch, permissions, deviceId: string (bounded)
    //   - roleKey: enum ['ADMIN', 'MANAGER', 'ACCOUNTANT', 'DEPUTY_ACCOUNTANT', 'EMPLOYEE']
    //   - active: bool
    //
    // Collection: /erp_clusters/{clusterCode}/email_directory/{emailKey}
    //   - email, userCode, username, branch, permissions: string (bounded)
    //   - roleKey: enum ['ADMIN', 'MANAGER', 'ACCOUNTANT', 'DEPUTY_ACCOUNTANT', 'EMPLOYEE']
    //   - active: bool
    //
    // Collection: /erp_clusters/{clusterCode}/user_accounts/{docId}
    //   - userCode, username, fullName, phoneOrEmail, pinOrPassword, role, branch, permissions: string (bounded)
    //   - linkedUid, remoteServerId, serverSyncToken, syncStatus, deviceId: string (bounded)
    //   - active: bool
    //
    // Collections: /erp_clusters/{clusterCode}/{movements|transfers|invoice_payments}/{docId}
    //   - Financial ledger entries: append/create + controlled one-time reversal only; direct delete denied.
    //
    // Collection: /erp_clusters/{clusterCode}/invoices/{docId}
    //   - Invoices: soft-cancellation (status 'ملغاة'/'cancelled') and payment summary updates only; non-Admin delete denied.
    //
    // Operational Collections (Web/Desktop & Android Sync):
    //   - shift_production_logs, press_machines, tool_custodies, in_transit_shipments:
    //       Active cluster members (branch-scoped) can read/create/update; Manager/Admin can delete.
    //   - daily_checklists, employee_tasks:
    //       Active cluster members (branch-scoped) can read; employees can toggle/update completion/status
    //       fields on own/role/unassigned items without mutating task definitions; Manager/Admin full edit/delete.
    //   - seqaofa_entries:
    //       Treasury-authorized roles (Admin/Manager/Accountant/Deputy/Treasury grant, branch-scoped) can create/update; Admin-only delete.
    //   - financial_budgets, employee_rewards:
    //       Active cluster members (branch-scoped) can read; Admin/Manager/Accountant only can create/update; Admin-only delete.
    //
    // ===============================================================

    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isNonAnonymousAuth() {
      return request.auth != null && (
        !('firebase' in request.auth.token) ||
        !(request.auth.token.firebase is map) ||
        !('sign_in_provider' in request.auth.token.firebase) ||
        request.auth.token.firebase.sign_in_provider != 'anonymous'
      );
    }

    function isSignedIn() {
      return isNonAnonymousAuth();
    }

    function hasVerifiedEmail() {
      return isNonAnonymousAuth() &&
        ('email' in request.auth.token) &&
        (request.auth.token.email is string) &&
        request.auth.token.email.size() > 0 &&
        ('email_verified' in request.auth.token) &&
        request.auth.token.email_verified == true;
    }

    function isBootstrapAdminEmail() {
      return hasVerifiedEmail() &&
        request.auth.token.email.lower() in ['oaw7ab@gmail.com', 'admin@pmp-paints.com'];
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() >= 1 && val.size() <= maxLen;
    }

    function isOptionalString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isNullableOptionalString(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }

    function isReasonablePayload() {
      return request.resource == null || request.resource.data.keys().size() <= 120;
    }

    function isNotVersionDowngrade() {
      return resource == null ||
        !('versionCode' in resource.data) ||
        !('versionCode' in request.resource.data) ||
        (request.resource.data.versionCode is number &&
          request.resource.data.versionCode >= 1 &&
          (!(resource.data.versionCode is number) || request.resource.data.versionCode >= resource.data.versionCode));
    }

    // 3. Enterprise Cluster Membership & RBAC Helpers (Single-Lookup, Zero-Trust)
    function memberPath(clusterCode, uid) {
      return /databases/$(database)/documents/erp_clusters/$(clusterCode)/cluster_members/$(uid);
    }

    function emailDirPath(clusterCode, emailKey) {
      return /databases/$(database)/documents/erp_clusters/$(clusterCode)/email_directory/$(emailKey);
    }

    function ownerLockPath(clusterCode) {
      return /databases/$(database)/documents/erp_clusters/$(clusterCode)/system_metadata/cluster_owner;
    }

    function hasTokenRoleClaim(clusterCode) {
      return isNonAnonymousAuth() &&
        ('roleKey' in request.auth.token) &&
        request.auth.token.roleKey in ['ADMIN', 'MANAGER', 'ACCOUNTANT', 'DEPUTY_ACCOUNTANT', 'EMPLOYEE'] &&
        (!('clusterCode' in request.auth.token) || request.auth.token.clusterCode == clusterCode);
    }

    function resolveMember(clusterCode) {
      return (isNonAnonymousAuth() && exists(memberPath(clusterCode, request.auth.uid)))
        ? get(memberPath(clusterCode, request.auth.uid)).data
        : (hasTokenRoleClaim(clusterCode)
            ? {'roleKey': request.auth.token.roleKey, 'branch': 'ALL', 'active': true, 'userCode': '', 'permissions': ''}
            : {'roleKey': 'NONE', 'branch': '', 'active': false, 'userCode': '', 'permissions': ''});
    }

    function isMemberAdmin(m) {
      return ('active' in m) && m.active == true && ('roleKey' in m) && m.roleKey == 'ADMIN';
    }

    function isMemberManager(m) {
      return ('active' in m) && m.active == true && ('roleKey' in m) && m.roleKey == 'MANAGER';
    }

    function isMemberAccountant(m) {
      return ('active' in m) && m.active == true && ('roleKey' in m) && m.roleKey == 'ACCOUNTANT';
    }

    function isMemberDeputyAccountant(m) {
      return ('active' in m) && m.active == true && ('roleKey' in m) && m.roleKey == 'DEPUTY_ACCOUNTANT';
    }

    function isClusterAdmin(clusterCode) {
      let m = resolveMember(clusterCode);
      return isNonAnonymousAuth() && isMemberAdmin(m);
    }

    function isClusterManager(clusterCode) {
      let m = resolveMember(clusterCode);
      return isNonAnonymousAuth() && isMemberManager(m);
    }

    function isActiveClusterMember(clusterCode) {
      let m = resolveMember(clusterCode);
      return isNonAnonymousAuth() && ('active' in m) && m.active == true && ('roleKey' in m) &&
        m.roleKey in ['ADMIN', 'MANAGER', 'ACCOUNTANT', 'DEPUTY_ACCOUNTANT', 'EMPLOYEE'];
    }

    function isGlobalBranchValue(branchVal) {
      return !(branchVal is string) ||
        branchVal.size() == 0 ||
        branchVal in ['ALL', 'الكل', 'الإدارة العامة', 'جميع الفروع'];
    }

    function canMemberAccessBranch(m, branchVal) {
      return isMemberAdmin(m) ||
        !('branch' in m) ||
        isGlobalBranchValue(m.branch) ||
        isGlobalBranchValue(branchVal) ||
        branchVal == m.branch;
    }

    function isPrivilegedArabicOrEnRole(roleStr) {
      return roleStr is string && (
        roleStr.matches('[\\s\\S]*(مدير النظام|المدير العام|Super\\s*Admin|SUPER_ADMIN|ADMIN|Admin|Manager|MANAGER|المدير|مشرف)[\\s\\S]*')
      );
    }

    function hasForbiddenAdminPermissions(d) {
      return ('permissions' in d) && (d.permissions is string) &&
        d.permissions.matches('[\\s\\S]*(USER_MANAGEMENT|ADMIN_SETTINGS|SCOPED_ADMIN|إدارة المستخدمين|الإعدادات الإدارية)[\\s\\S]*');
    }

    function isValidRoleKey(rk) {
      return rk in ['ADMIN', 'MANAGER', 'ACCOUNTANT', 'DEPUTY_ACCOUNTANT', 'EMPLOYEE'];
    }

    function hasTreasuryPermissionGrant(m) {
      return ('permissions' in m) &&
        (m.permissions is string) &&
        m.permissions.matches('.*(الخزن|العمليات المالية|التحويلات|TREASURY|FINANCIAL_OPS|TRANSFERS).*') &&
        !m.permissions.matches('.*DENY:(الخزن|العمليات المالية).*');
    }

    function memberHasPermString(m) {
      return ('permissions' in m) && (m.permissions is string);
    }

    function isLabSecretDenied(m) {
      return memberHasPermString(m) &&
        m.permissions.matches('.*DENY:(VIEW_SECRET_FORMULAS|المختبر الكيميائي|المختبر الكيميائي:VIEW|CHEMISTRY_LAB).*');
    }

    function hasLabSecretRead(m) {
      return ('active' in m) && m.active == true && (
        isMemberAdmin(m) ||
        (isMemberManager(m) && !isLabSecretDenied(m)) ||
        (memberHasPermString(m) &&
          m.permissions.matches('.*(VIEW_SECRET_FORMULAS|المختبر الكيميائي|Chemistry Lab|CHEMISTRY_LAB).*') &&
          !isLabSecretDenied(m))
      );
    }

    function hasLabEdit(m) {
      return hasLabSecretRead(m) && !(
        memberHasPermString(m) &&
        m.permissions.matches('.*(VIEW_ONLY|عرض فقط|DENY:EDIT|DENY:CREATE|DENY:EDIT_FORMULAS|DENY:المختبر الكيميائي:EDIT|DENY:المختبر الكيميائي:CREATE).*')
      );
    }

    function hasLabApprove(m) {
      return ('active' in m) && m.active == true && (
        isMemberAdmin(m) ||
        isMemberManager(m) ||
        (memberHasPermString(m) &&
          m.permissions.matches('.*(APPROVE_FORMULAS|اعتماد التركيبات|GRANT:المختبر الكيميائي:APPROVE).*'))
      ) && !(
        memberHasPermString(m) &&
        m.permissions.matches('.*DENY:(APPROVE_FORMULAS|APPROVE|المختبر الكيميائي:APPROVE).*')
      );
    }

    function hasQcGate(m) {
      return ('active' in m) && m.active == true && (
        isMemberAdmin(m) ||
        isMemberManager(m) ||
        (memberHasPermString(m) &&
          m.permissions.matches('.*(الجودة|QC|اعتماد الجودة|QC_OFFICER|LAB_EXPERIMENT).*'))
      ) && !(
        memberHasPermString(m) &&
        m.permissions.matches('.*DENY:(QC_DECISION|APPROVE|الجودة).*')
      );
    }

    function hasProcurementOrCostRead(m) {
      return ('active' in m) && m.active == true && (
        isMemberAdmin(m) ||
        isMemberManager(m) ||
        isMemberAccountant(m) ||
        hasLabSecretRead(m) ||
        (memberHasPermString(m) &&
          m.permissions.matches('.*(المشتريات|المخازن|PURCHAS|WAREHOUSE|خامات المصنع).*'))
      );
    }

    function isApprovingFormulaWrite(d) {
      return (('approvalStatus' in d) && d.approvalStatus == 'APPROVED') ||
        (('approvedForProduction' in d) && d.approvedForProduction == true);
    }

    function isAllowedErpCollection(col) {
      return col in [
        'user_accounts', 'pending_requests',
        'invoices', 'invoice_items', 'invoice_payments',
        'movements', 'transfers', 'daily_closings',
        'customers', 'products', 'stock_moves',
        'warehouses', 'cashboxes', 'inventory_weights',
        'factory_items', 'factory_machines', 'factory_moves',
        'halfa_invoices', 'poster_prices', 'audit_logs',
        'server_status', 'deleted_users',
        'lab_formulations', 'formulations', 'lab_formula_summaries',
        'lab_formula_versions', 'lab_experiments', 'raw_material_price_history', 'lab_excel_imports',
        'paint_batches', 'chemical_safety',
        'purchase_orders', 'purchase_receipts', 'goods_receipts', 'production_orders', 'qc_inspections', 'fg_receipts', 'sales_deliveries',
        'inventory_movements', 'warehouse_stock_balances', 'warehouse_transfers', 'warehouse_transfer_items', 'packaging_rules', 'stock_batches',
        'accounting_accounts', 'journal_entries', 'journal_lines',
        'deleted_records', 'system_metadata', 'system_config', 'app_updates',
        'permission_audit_logs', 'config',
        'idempotency_requests',
        'employee_tasks', 'shift_production_logs', 'press_machines', 'tool_custodies',
        'daily_checklists', 'seqaofa_entries', 'in_transit_shipments',
        'financial_budgets', 'employee_rewards'
      ];
    }

    // 4. Linked Employee Accounts (/linked_accounts/{accountCode})
    //    Strictly enforces non-anonymous Firebase Authentication, ownerId/linkedUid isolation,
    //    schema validation, and prevents employee privilege escalation.
    match /linked_accounts/{accountCode} {
      function isAccountOwner() {
        return isNonAnonymousAuth() && resource != null && resource.data.ownerId == request.auth.uid;
      }

      function isLinkedEmployee() {
        return isNonAnonymousAuth() && resource != null && resource.data.linkedUid == request.auth.uid;
      }

      function isValidLinkedAccountCreate(docId) {
        let data = request.resource.data;
        let allowedKeys = [
          'userCode', 'ownerId', 'linkedUid', 'clusterCode', 'fullName', 'username',
          'role', 'branch', 'permissions', 'serverSyncToken',
          'active', 'createdAt', 'updatedAt'
        ];
        return isNonAnonymousAuth() &&
          isReasonablePayload() &&
          data.keys().hasAll([
            'userCode', 'ownerId', 'linkedUid', 'fullName', 'username',
            'role', 'branch', 'permissions', 'serverSyncToken', 'active', 'createdAt', 'updatedAt'
          ]) &&
          data.keys().hasOnly(allowedKeys) &&
          data.userCode == docId &&
          data.ownerId == request.auth.uid &&
          isNonEmptyString(data.linkedUid, 128) &&
          isNonEmptyString(data.fullName, 120) &&
          isNonEmptyString(data.username, 60) &&
          isNonEmptyString(data.role, 80) &&
          isNonEmptyString(data.branch, 100) &&
          isOptionalString(data.permissions, 2000) &&
          isNonEmptyString(data.serverSyncToken, 120) &&
          (!('clusterCode' in data) || isOptionalString(data.clusterCode, 80)) &&
          data.active is bool &&
          data.createdAt is timestamp &&
          data.updatedAt is timestamp;
      }

      // Tier 1: Account Owner (Admin) updates employee permissions, role, branch, or active status
      function isValidManagerUpdate() {
        let data = request.resource.data;
        let allowedKeys = [
          'userCode', 'ownerId', 'linkedUid', 'clusterCode', 'fullName', 'username',
          'role', 'branch', 'permissions', 'serverSyncToken',
          'active', 'createdAt', 'updatedAt'
        ];
        return isAccountOwner() &&
          isReasonablePayload() &&
          data.keys().hasAll([
            'userCode', 'ownerId', 'linkedUid', 'fullName', 'username',
            'role', 'branch', 'permissions', 'serverSyncToken', 'active', 'createdAt', 'updatedAt'
          ]) &&
          data.keys().hasOnly(allowedKeys) &&
          data.userCode == resource.data.userCode &&
          data.ownerId == resource.data.ownerId &&
          data.createdAt == resource.data.createdAt &&
          (!('clusterCode' in resource.data) || (('clusterCode' in data) && data.clusterCode == resource.data.clusterCode)) &&
          (!('clusterCode' in data) || isOptionalString(data.clusterCode, 80)) &&
          isNonEmptyString(data.linkedUid, 128) &&
          isNonEmptyString(data.fullName, 120) &&
          isNonEmptyString(data.username, 60) &&
          isNonEmptyString(data.role, 80) &&
          isNonEmptyString(data.branch, 100) &&
          isOptionalString(data.permissions, 2000) &&
          isNonEmptyString(data.serverSyncToken, 120) &&
          data.active is bool &&
          data.updatedAt is timestamp;
      }

      // Tier 2: Linked Employee updates ONLY sync acknowledgment fields (blocks permissions/role escalation)
      function isValidEmployeeSyncUpdate() {
        let data = request.resource.data;
        let changedKeys = data.diff(resource.data).affectedKeys();
        return isLinkedEmployee() &&
          isReasonablePayload() &&
          changedKeys.hasOnly(['serverSyncToken', 'updatedAt']) &&
          isNonEmptyString(data.serverSyncToken, 120) &&
          data.updatedAt is timestamp;
      }

      allow get: if isAccountOwner() || isLinkedEmployee();
      allow list: if isAccountOwner() || isLinkedEmployee();
      allow create: if isNonAnonymousAuth() && isValidId(accountCode) && isValidLinkedAccountCreate(accountCode);
      allow update: if isNonAnonymousAuth() && isValidId(accountCode) && (isValidManagerUpdate() || isValidEmployeeSyncUpdate());
      allow delete: if isAccountOwner();
    }

    // 5. Root Configuration, Updates & Tombstones (Hardened Auth & Role Scopes)
    match /system_config/{docId} {
      allow read: if isValidId(docId);
      allow create, update: if isNonAnonymousAuth() && isValidId(docId) && isReasonablePayload() && isNotVersionDowngrade() && isClusterAdmin('PMP-ERP-MAIN-CLUSTER');
      allow delete: if isNonAnonymousAuth() && isValidId(docId) && isClusterAdmin('PMP-ERP-MAIN-CLUSTER');
    }

    match /app_updates/{docId} {
      allow read: if isValidId(docId);
      allow create, update: if isNonAnonymousAuth() && isValidId(docId) && isReasonablePayload() && isNotVersionDowngrade() && isClusterAdmin('PMP-ERP-MAIN-CLUSTER');
      allow delete: if isNonAnonymousAuth() && isValidId(docId) && isClusterAdmin('PMP-ERP-MAIN-CLUSTER');
    }

    match /deleted_records/{docId} {
      allow read: if isNonAnonymousAuth() && isValidId(docId) && isActiveClusterMember('PMP-ERP-MAIN-CLUSTER');
      allow create, update: if isNonAnonymousAuth() && isValidId(docId) && isReasonablePayload() && (isClusterAdmin('PMP-ERP-MAIN-CLUSTER') || isClusterManager('PMP-ERP-MAIN-CLUSTER'));
      allow delete: if isNonAnonymousAuth() && isValidId(docId) && isClusterAdmin('PMP-ERP-MAIN-CLUSTER');
    }

    match /deleted_accounts/{accountCode} {
      allow read: if isNonAnonymousAuth() && isValidId(accountCode) && isActiveClusterMember('PMP-ERP-MAIN-CLUSTER');
      allow create, update: if isNonAnonymousAuth() && isValidId(accountCode) && isReasonablePayload() && (isClusterAdmin('PMP-ERP-MAIN-CLUSTER') || isClusterManager('PMP-ERP-MAIN-CLUSTER'));
      allow delete: if isNonAnonymousAuth() && isValidId(accountCode) && isClusterAdmin('PMP-ERP-MAIN-CLUSTER');
    }

    match /permission_audit_logs/{logId} {
      allow read: if isNonAnonymousAuth() && isValidId(logId) && (isClusterAdmin('PMP-ERP-MAIN-CLUSTER') || isClusterManager('PMP-ERP-MAIN-CLUSTER'));
      allow create: if isNonAnonymousAuth() && isValidId(logId) && isReasonablePayload() && (isClusterAdmin('PMP-ERP-MAIN-CLUSTER') || isClusterManager('PMP-ERP-MAIN-CLUSTER'));
      allow update, delete: if false;
    }

    // 6. Chemical Formulations and Paint Batch Data (RBAC-Protected Lab IP & Batch Data)
    match /lab_formulations/{formulaId} {
      allow read: if isNonAnonymousAuth() && isValidId(formulaId) && hasLabSecretRead(resolveMember('PMP-ERP-MAIN-CLUSTER'));
      allow create, update: if isNonAnonymousAuth() && isValidId(formulaId) && isReasonablePayload() &&
        hasLabEdit(resolveMember('PMP-ERP-MAIN-CLUSTER')) &&
        (!isApprovingFormulaWrite(request.resource.data) || hasLabApprove(resolveMember('PMP-ERP-MAIN-CLUSTER')));
      allow delete: if isNonAnonymousAuth() && isValidId(formulaId) && (isClusterAdmin('PMP-ERP-MAIN-CLUSTER') || isClusterManager('PMP-ERP-MAIN-CLUSTER'));
    }

    match /paint_batches/{batchId} {
      allow read: if isNonAnonymousAuth() && isValidId(batchId) && isActiveClusterMember('PMP-ERP-MAIN-CLUSTER');
      allow create, update: if isNonAnonymousAuth() && isValidId(batchId) && isReasonablePayload() && isActiveClusterMember('PMP-ERP-MAIN-CLUSTER');
      allow delete: if isNonAnonymousAuth() && isValidId(batchId) && (isClusterAdmin('PMP-ERP-MAIN-CLUSTER') || isClusterManager('PMP-ERP-MAIN-CLUSTER'));
    }

    // 7. Collection Semantics & Payload Validation Helpers
    function isImmutableAuditCollection(col) {
      return col in ['audit_logs', 'permission_audit_logs'];
    }

    function isAppendOnlyMovementCollection(col) {
      return col in ['inventory_movements', 'journal_entries'];
    }

    function isImmutableJournalLineCollection(col) {
      return col == 'journal_lines';
    }

    function isImmutableFinancialLedgerCollection(col) {
      return col in ['movements', 'transfers', 'invoice_payments'];
    }

    function isIdempotencyCollection(col) {
      return col == 'idempotency_requests';
    }

    function isValidFinancialLedgerReversal() {
      let d = request.resource.data;
      return (!('status' in resource.data) || !(resource.data.status in ['reversed', 'REVERSED', 'cancelled', 'CANCELLED', 'ملغاة'])) &&
        ('status' in d) &&
        (d.status in ['reversed', 'REVERSED', 'cancelled', 'CANCELLED', 'ملغاة']) &&
        d.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reversedByRef', 'reversedByEntryNo', 'reversedMovementId',
          'reversalReason', 'reversedAt', 'updatedAt', 'serverUpdatedAt', 'serverUpdatedBy', 'recordVersion'
        ]) &&
        (!('reversalReason' in d) || isNullableOptionalString(d.reversalReason, 500)) &&
        (!('reversedByRef' in d) || isNullableOptionalString(d.reversedByRef, 160)) &&
        (!('reversedByEntryNo' in d) || isNullableOptionalString(d.reversedByEntryNo, 128)) &&
        (!('serverUpdatedBy' in d) || isNullableOptionalString(d.serverUpdatedBy, 128));
    }

    function isValidInvoiceSummaryUpdate() {
      let d = request.resource.data;
      return (!('status' in resource.data) || !(resource.data.status in ['ملغاة', 'cancelled', 'CANCELLED'])) &&
        d.diff(resource.data).affectedKeys().hasOnly([
          'paidAmount', 'status', 'payments', 'cancelReason', 'updatedAt', 'serverUpdatedAt', 'serverUpdatedBy'
        ]) &&
        (!('paidAmount' in d) || !('total' in d) || !(d.paidAmount is number) || !(d.total is number) || d.paidAmount <= d.total + 0.05) &&
        (!('serverUpdatedBy' in d) || isNullableOptionalString(d.serverUpdatedBy, 128));
    }

    function isValidErpDocWrite(col) {
      let d = request.resource.data;
      return isReasonablePayload() &&
        (col != 'invoices' || (
          (!('total' in d) || (d.total is number && d.total >= 0)) &&
          (!('subtotal' in d) || (d.subtotal is number && d.subtotal >= 0)) &&
          (!('discount' in d) || (d.discount is number && d.discount >= 0)) &&
          (!('discountAmount' in d) || (d.discountAmount is number && d.discountAmount >= 0)) &&
          (!('taxAmount' in d) || (d.taxAmount is number && d.taxAmount >= 0)) &&
          (!('paidAmount' in d) || (d.paidAmount is number && d.paidAmount >= 0)) &&
          (!('customerName' in d) || isNonEmptyString(d.customerName, 200)) &&
          (!('currency' in d) || d.currency in ['SDG', 'EGP', 'USD']) &&
          (!('status' in d) || isNullableOptionalString(d.status, 60)) &&
          (!('cancelReason' in d) || isNullableOptionalString(d.cancelReason, 500)) &&
          (!('notes' in d) || isNullableOptionalString(d.notes, 2000)) &&
          (!('itemsJson' in d) || isNullableOptionalString(d.itemsJson, 200000)) &&
          (!('payments' in d) || d.payments == null || (d.payments is list && d.payments.size() <= 500))
        )) &&
        (col != 'invoice_payments' || (
          (!('amount' in d) || (d.amount is number && d.amount > 0)) &&
          (!('currency' in d) || d.currency in ['SDG', 'EGP', 'USD']) &&
          (!('cashbox' in d) || isOptionalString(d.cashbox, 120)) &&
          (!('note' in d) || isNullableOptionalString(d.note, 1000)) &&
          (!('status' in d) || isOptionalString(d.status, 40)) &&
          (!('reversalReason' in d) || isNullableOptionalString(d.reversalReason, 500)) &&
          (!('reversedByRef' in d) || isNullableOptionalString(d.reversedByRef, 160))
        )) &&
        (col != 'movements' || (
          (!('amount' in d) || (d.amount is number && d.amount >= 0)) &&
          (!('direction' in d) || d.direction in ['وارد', 'منصرف', 'IN', 'OUT', 'INCOME', 'EXPENSE', 'TRANSFER_IN', 'TRANSFER_OUT', 'قبض', 'صرف']) &&
          (!('currency' in d) || d.currency in ['SDG', 'EGP', 'USD']) &&
          (!('cashbox' in d) || isNonEmptyString(d.cashbox, 120)) &&
