    match /erp_clusters/{clusterCode}/idempotency_requests/{docId} {
      function isValidIdemDoc() {
        let d = request.resource.data;
        return isReasonablePayload() &&
          ('idempotencyKey' in d) && isNonEmptyString(d.idempotencyKey, 128) &&
          ('operationType' in d) && isNonEmptyString(d.operationType, 80) &&
          ('requestStatus' in d) && d.requestStatus in ['DRAFT', 'PROCESSING', 'PENDING_CONFIRMATION', 'COMPLETED', 'FAILED', 'CANCELLED'] &&
          (!('userId' in d) || isNullableOptionalString(d.userId, 128)) &&
          (!('documentReference' in d) || isNullableOptionalString(d.documentReference, 200)) &&
          (!('payloadSummary' in d) || isNullableOptionalString(d.payloadSummary, 500)) &&
          (!('platform' in d) || isNullableOptionalString(d.platform, 40)) &&
          (!('resultReference' in d) || isNullableOptionalString(d.resultReference, 256)) &&
          (!('errorDetails' in d) || isNullableOptionalString(d.errorDetails, 1000));
      }
      allow get, list: if isNonAnonymousAuth() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isActiveClusterMember(clusterCode);
      allow create: if isNonAnonymousAuth() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isValidId(docId) && isActiveClusterMember(clusterCode) && isValidIdemDoc();
      allow update: if isNonAnonymousAuth() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isValidId(docId) && isActiveClusterMember(clusterCode) && isValidIdemDoc() &&
        resource.data.requestStatus != 'COMPLETED' &&
        request.resource.data.idempotencyKey == resource.data.idempotencyKey &&
        request.resource.data.operationType == resource.data.operationType;
      allow delete: if false;
    }

    // 8d-lab. Dedicated Low-Expression Rules for Chemical Lab IP, Versions, QC & Price History
    function isLabCollection(col) {
      return col in [
        'lab_formulations', 'formulations', 'lab_formula_versions',
        'lab_formula_summaries', 'lab_experiments', 'lab_excel_imports', 'raw_material_price_history'
      ];
    }

    match /erp_clusters/{clusterCode}/lab_formulations/{docId} {
      allow read: if isNonAnonymousAuth() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' &&
        hasLabSecretRead(resolveMember(clusterCode));
      allow create, update: if isNonAnonymousAuth() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isValidId(docId) && isReasonablePayload() &&
        (hasLabEdit(resolveMember(clusterCode)) || hasLabApprove(resolveMember(clusterCode))) &&
        (!isApprovingFormulaWrite(request.resource.data) || hasLabApprove(resolveMember(clusterCode)));
      allow delete: if isNonAnonymousAuth() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isValidId(docId) &&
        (isClusterAdmin(clusterCode) || (isClusterManager(clusterCode) && !isLabSecretDenied(resolveMember(clusterCode))));
    }

    match /erp_clusters/{clusterCode}/formulations/{docId} {
      allow read: if isNonAnonymousAuth() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' &&
        hasLabSecretRead(resolveMember(clusterCode));
      allow create, update: if isNonAnonymousAuth() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isValidId(docId) && isReasonablePayload() &&
        (hasLabEdit(resolveMember(clusterCode)) || hasLabApprove(resolveMember(clusterCode))) &&
        (!isApprovingFormulaWrite(request.resource.data) || hasLabApprove(resolveMember(clusterCode)));
      allow delete: if isNonAnonymousAuth() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isValidId(docId) &&
        (isClusterAdmin(clusterCode) || (isClusterManager(clusterCode) && !isLabSecretDenied(resolveMember(clusterCode))));
    }

    match /erp_clusters/{clusterCode}/lab_formula_versions/{docId} {
      allow read: if isNonAnonymousAuth() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' &&
        hasLabSecretRead(resolveMember(clusterCode));
      allow create: if isNonAnonymousAuth() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isValidId(docId) && isReasonablePayload() &&
        (hasLabEdit(resolveMember(clusterCode)) || hasLabApprove(resolveMember(clusterCode))) &&
        (!isApprovingFormulaWrite(request.resource.data) || hasLabApprove(resolveMember(clusterCode)));
      allow update: if isNonAnonymousAuth() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isValidId(docId) && isReasonablePayload() &&
        (hasLabEdit(resolveMember(clusterCode)) || hasLabApprove(resolveMember(clusterCode))) &&
        (!isApprovingFormulaWrite(request.resource.data) || hasLabApprove(resolveMember(clusterCode))) &&
        (!('approvalStatus' in resource.data) || resource.data.approvalStatus != 'APPROVED' || hasLabApprove(resolveMember(clusterCode)));
      allow delete: if isNonAnonymousAuth() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isValidId(docId) && isClusterAdmin(clusterCode);
    }

    match /erp_clusters/{clusterCode}/lab_formula_summaries/{docId} {
      allow read: if isNonAnonymousAuth() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isActiveClusterMember(clusterCode);
      allow create, update: if isNonAnonymousAuth() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isValidId(docId) && isReasonablePayload() &&
        !('ingredientsJson' in request.resource.data) && !('ingredients' in request.resource.data) &&
        !('confidentialCiphertext' in request.resource.data) && !('saltBase64' in request.resource.data) && !('ivBase64' in request.resource.data) &&
        (hasLabEdit(resolveMember(clusterCode)) || hasLabApprove(resolveMember(clusterCode)));
      allow delete: if isNonAnonymousAuth() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isValidId(docId) && (isClusterAdmin(clusterCode) || isClusterManager(clusterCode));
    }

    match /erp_clusters/{clusterCode}/lab_experiments/{docId} {
      allow read: if isNonAnonymousAuth() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isActiveClusterMember(clusterCode);
      allow create, update: if isNonAnonymousAuth() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isValidId(docId) && isReasonablePayload() &&
        !('ingredientsJson' in request.resource.data) && !('confidentialCiphertext' in request.resource.data) &&
        !('saltBase64' in request.resource.data) && !('ivBase64' in request.resource.data) &&
        (hasLabEdit(resolveMember(clusterCode)) || hasQcGate(resolveMember(clusterCode))) &&
        (!('decision' in request.resource.data) || !(request.resource.data.decision in ['APPROVED', 'REJECTED', 'RETEST']) || hasQcGate(resolveMember(clusterCode))) &&
        (!('status' in request.resource.data) || !(request.resource.data.status in ['PASSED', 'FAILED', 'RETEST_REQUIRED']) || hasQcGate(resolveMember(clusterCode)));
      allow delete: if isNonAnonymousAuth() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isValidId(docId) && (isClusterAdmin(clusterCode) || isClusterManager(clusterCode));
    }

    match /erp_clusters/{clusterCode}/lab_excel_imports/{docId} {
      allow read: if isNonAnonymousAuth() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && hasLabSecretRead(resolveMember(clusterCode));
      allow create, update: if isNonAnonymousAuth() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isValidId(docId) && isReasonablePayload() &&
        hasLabEdit(resolveMember(clusterCode));
      allow delete: if isNonAnonymousAuth() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isValidId(docId) && (isClusterAdmin(clusterCode) || isClusterManager(clusterCode));
    }

    match /erp_clusters/{clusterCode}/raw_material_price_history/{docId} {
      allow read: if isNonAnonymousAuth() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' &&
        hasProcurementOrCostRead(resolveMember(clusterCode));
      allow create, update: if isNonAnonymousAuth() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isValidId(docId) && isReasonablePayload() &&
        hasProcurementOrCostRead(resolveMember(clusterCode)) &&
        (!('newPrice' in request.resource.data) || (request.resource.data.newPrice is number && request.resource.data.newPrice >= 0)) &&
        (!('previousPrice' in request.resource.data) || (request.resource.data.previousPrice is number && request.resource.data.previousPrice >= 0));
      allow delete: if isNonAnonymousAuth() && isValidId(clusterCode) && clusterCode != 'PMP-ERP-V16-CLUSTER' && isValidId(docId) && isClusterAdmin(clusterCode);
    }

    // 8e. Operational ERP Collections inside Cluster
    match /erp_clusters/{clusterCode}/{collectionName}/{docId} {
      allow get, list: if isNonAnonymousAuth() &&
        isValidId(clusterCode) &&
        clusterCode != 'PMP-ERP-V16-CLUSTER' &&
        isAllowedErpCollection(collectionName) &&
        !(collectionName in ['user_accounts', 'pending_requests', 'idempotency_requests']) &&
        !isLabCollection(collectionName) &&
        canReadErpCollection(clusterCode, collectionName);

      allow create: if isNonAnonymousAuth() &&
        isValidId(clusterCode) &&
        clusterCode != 'PMP-ERP-V16-CLUSTER' &&
        isAllowedErpCollection(collectionName) &&
        !(collectionName in ['user_accounts', 'pending_requests', 'idempotency_requests']) &&
        !isLabCollection(collectionName) &&
        isValidId(docId) &&
        isValidErpDocWrite(collectionName) &&
        canCreateErpCollection(clusterCode, collectionName);

      allow update: if isNonAnonymousAuth() &&
        isValidId(clusterCode) &&
        clusterCode != 'PMP-ERP-V16-CLUSTER' &&
        isAllowedErpCollection(collectionName) &&
        !(collectionName in ['user_accounts', 'pending_requests', 'idempotency_requests']) &&
        !isLabCollection(collectionName) &&
        !isImmutableAuditCollection(collectionName) &&
        !isImmutableJournalLineCollection(collectionName) &&
        isValidId(docId) &&
        isValidErpDocWrite(collectionName) &&
        canUpdateErpCollection(clusterCode, collectionName) &&
        (!isAppendOnlyMovementCollection(collectionName) || (
          request.resource.data.status == 'REVERSED' &&
          resource.data.status == 'POSTED' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reversedByEntryNo', 'reversalReason', 'recordVersion', 'updatedAt', 'serverUpdatedAt', 'serverUpdatedBy'])
        )) &&
        (!isImmutableFinancialLedgerCollection(collectionName) || isValidFinancialLedgerReversal()) &&
        (collectionName != 'invoices' || isValidInvoiceSummaryUpdate());

      allow delete: if isNonAnonymousAuth() &&
        isValidId(clusterCode) &&
        clusterCode != 'PMP-ERP-V16-CLUSTER' &&
        isAllowedErpCollection(collectionName) &&
        !(collectionName in ['user_accounts', 'pending_requests', 'idempotency_requests']) &&
        !isLabCollection(collectionName) &&
        !isImmutableAuditCollection(collectionName) &&
        !isAppendOnlyMovementCollection(collectionName) &&
        !isImmutableJournalLineCollection(collectionName) &&
        !isImmutableFinancialLedgerCollection(collectionName) &&
        isValidId(docId) &&
        canDeleteErpCollection(clusterCode, collectionName);
    }

    match /erp_clusters/{clusterCode}/{collectionName}/{docId}/{subCollection}/{subDocId} {
      allow get, list: if isNonAnonymousAuth() &&
        isValidId(clusterCode) &&
        clusterCode != 'PMP-ERP-V16-CLUSTER' &&
        isAllowedErpCollection(collectionName) &&
        isValidId(docId) &&
        isActiveClusterMember(clusterCode);

      allow create: if isNonAnonymousAuth() &&
        isValidId(clusterCode) &&
        clusterCode != 'PMP-ERP-V16-CLUSTER' &&
        isAllowedErpCollection(collectionName) &&
        isValidId(docId) &&
        isValidId(subDocId) &&
        isReasonablePayload() &&
        canCreateErpCollection(clusterCode, collectionName);

      allow update, delete: if isNonAnonymousAuth() &&
        isValidId(clusterCode) &&
        clusterCode != 'PMP-ERP-V16-CLUSTER' &&
        isAllowedErpCollection(collectionName) &&
        !isImmutableAuditCollection(collectionName) &&
        !isAppendOnlyMovementCollection(collectionName) &&
        !isImmutableJournalLineCollection(collectionName) &&
        !isImmutableFinancialLedgerCollection(collectionName) &&
        !isIdempotencyCollection(collectionName) &&
        isValidId(docId) &&
        isValidId(subDocId) &&
        isReasonablePayload() &&
        canDeleteErpCollection(clusterCode, collectionName);
    }
  }
}
