    function matchesMemberIdentity(m, val) {
      return val is string && val.size() > 0 && (
        val == request.auth.uid ||
        (('userCode' in m) && m.userCode is string && m.userCode.size() > 0 && val == m.userCode) ||
        (('username' in m) && m.username is string && m.username.size() > 0 && val.lower() == m.username.lower()) ||
        (('fullName' in m) && m.fullName is string && m.fullName.size() > 0 && val == m.fullName) ||
        (('email' in m) && m.email is string && m.email.size() > 0 && val.lower() == m.email.lower())
      );
    }

    function isTaskOrChecklistActor(m, res) {
      let hasAssigneeUid = ('assigneeUid' in res) && res.assigneeUid is string && res.assigneeUid.size() > 0;
      let hasAssigneeUsername = ('assigneeUsername' in res) && res.assigneeUsername is string && res.assigneeUsername.size() > 0;
      let isSpecificallyAssigned = hasAssigneeUid || hasAssigneeUsername;
      let matchesAssignee =
        (hasAssigneeUid && res.assigneeUid == request.auth.uid) ||
        (hasAssigneeUsername && matchesMemberIdentity(m, res.assigneeUsername));
      let matchesCreator =
        (('createdByUid' in res) && res.createdByUid is string && res.createdByUid == request.auth.uid) ||
        (('createdBy' in res) && matchesMemberIdentity(m, res.createdBy)) ||
        (('assignedBy' in res) && matchesMemberIdentity(m, res.assignedBy));
      return matchesAssignee || matchesCreator || !isSpecificallyAssigned;
    }

    function isSelfOrUnassignedTaskCreate(m, d) {
      let assigneeUidOk = !('assigneeUid' in d) || d.assigneeUid == null || d.assigneeUid == '' || d.assigneeUid == request.auth.uid;
      let assigneeUserOk = !('assigneeUsername' in d) || d.assigneeUsername == null || d.assigneeUsername == '' || matchesMemberIdentity(m, d.assigneeUsername);
      return assigneeUidOk && assigneeUserOk;
    }

    // Single-lookup Collection-level Role Authorization Matrices
    function canReadErpCollection(clusterCode, col) {
      let m = resolveMember(clusterCode);
      return isNonAnonymousAuth() && ('active' in m) && m.active == true && ('roleKey' in m) &&
        m.roleKey in ['ADMIN', 'MANAGER', 'ACCOUNTANT', 'DEPUTY_ACCOUNTANT', 'EMPLOYEE'] && (
          isMemberAdmin(m) ||
          (col in ['system_config', 'system_metadata', 'config']) ||
          (!(col in ['system_config', 'system_metadata', 'config']) && (
            !('branch' in resource.data) || canMemberAccessBranch(m, resource.data.branch)
