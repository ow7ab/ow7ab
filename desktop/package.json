{
  "name": "pmp-paints-desktop",
  "productName": "PMP PAINTS ERP",
  "version": "18.0.0",
  "description": "PMP PAINTS Enterprise Cloud ERP — Official Windows Desktop Edition",
  "author": "PMP Paints Industrial & Financial Systems",
  "license": "ISC",
  "main": "src/main.cjs",
  "scripts": {
    "sync:renderer": "node scripts/sync-renderer.mjs",
    "dev": "node scripts/sync-renderer.mjs && node node_modules/electron/cli.js .",
    "start": "node node_modules/electron/cli.js .",
    "test": "node --test tests/*.test.mjs",
    "pack:dir": "node scripts/sync-renderer.mjs && node node_modules/electron-builder/cli.js --dir",
    "dist:win": "node scripts/sync-renderer.mjs && node node_modules/electron-builder/cli.js --win nsis portable --x64 --publish never",
    "dist:portable": "node scripts/sync-renderer.mjs && node node_modules/electron-builder/cli.js --win portable --x64 --publish never",
    "dist:mac": "node scripts/sync-renderer.mjs && node node_modules/electron-builder/cli.js --mac dmg zip --publish never",
    "dist:linux": "node scripts/sync-renderer.mjs && node node_modules/electron-builder/cli.js --linux AppImage deb --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.aistudio.pmppaints.erp.desktop",
    "productName": "PMP PAINTS ERP",
    "copyright": "Copyright © 2026 PMP Paints for Chemical Industries & Coatings",
    "asar": true,
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "renderer-dist/**/*",
      "assets/icon.ico",
      "assets/icon.png",
      "assets/tray-icon.png",
      "!tests/**"
    ],
    "extraMetadata": {
      "main": "src/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "pmp-paints-desktop-${target}-${version}-${arch}.${ext}",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PMP PAINTS ERP",
      "uninstallDisplayName": "PMP PAINTS ERP",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "include": "assets/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "artifactName": "pmp-paints-desktop-setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "pmp-paints-desktop-portable-${version}-${arch}.${ext}"
    },
    "mac": {
      "category": "public.app-category.business",
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "category": "Office",
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ow7ab",
        "repo": "ow7ab",
        "releaseType": "release",
        "vPrefixedTagName": false
      }
    ]
  }
}
